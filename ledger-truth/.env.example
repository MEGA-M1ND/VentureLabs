# Copy to .env and fill in. NEVER commit .env.
# Test-mode credentials only. A key that does not start with rzp_test_ must be
# rejected by the harness -- see ledgertruth.providers.razorpay guardrail.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Anthropic API key for the agent under test
ANTHROPIC_API_KEY=

# Chaos proxy listen address (empty = no fault injection)
LEDGERTRUTH_PROXY_ADDR=
