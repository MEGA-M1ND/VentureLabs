# Defence in depth: credentials must never be committed anywhere in this repo,
# regardless of what a subproject's own .gitignore says.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Captured run data may contain live ledger identifiers.
runs/
